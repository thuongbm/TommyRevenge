  m_Script: {fileID: 11500000, guid: 1d29d9832b67a8c42939a84a35e24b5c, type: 3}
  m_Name: Chapter1_TutorialDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - name: "H\u01B0\u1EDBng d\u1EABn"
    sentences:
    - "Ch\xE0o m\u1EEBng b\u1EA1n \u0111\u1EBFn v\u1EDBi Tommy Revenge!"
    - "D\xF9ng ph\xEDm A / D ho\u1EB7c \u2190 / \u2192 \u0111\u1EC3 di chuy\u1EC3n."
    - "Nh\u1EA5n SPACE \u0111\u1EC3 nh\u1EA3y."
    - "Nh\u1EA5n chu\u1ED9t tr\xE1i \u0111\u1EC3 b\u1EAFn."
    - "H\xE3y ti\xEAu di\u1EC7t k\u1EBB th\xF9 v\xE0 ti\u1EBFn v\u1EC1 ph\xEDa tr\u01B0\u1EDBc!"
  - name: "H\u01B0\u1EDBng d\u1EABn"
    sentences:
    - "Ch\xFA \xFD \u0111\u1EBFn thanh m\xE1u \u1EDF g\xF3c tr\xEAn m\xE0n h\xECnh."
    - "Tr\xE1nh b\u1ECB k\u1EBB th\xF9 t\u1EA5n c\xF4ng \u0111\u1EC3 kh\xF4ng m\u1EA5t
      m\u1EA1ng."
    - "Ch\xFAc b\u1EA1n ch\u01A1i vui!  \U0001F3AE"
